<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for devices older than API 31.
    See https://developer.android.com/guide/topics/data/autobackup
    Note: This file is ignored for devices API 31+ (uses data_extraction_rules.xml instead).
-->
<full-backup-content>
    <!--
        Exclude the sync credentials SharedPreferences file from backup.
        The file contains the plaintext sync server password (ondict_sync.xml).
        Users re-enter credentials on a new device; their data is restored
        via the sync server itself.
    -->
    <exclude domain="sharedpref" path="ondict_sync.xml"/>
</full-backup-content>
